{
  "exclude": [
    "**/node_modules",
    "**/venv",
    "**/dist",
    "**/.cache",
    "**/.mypy_cache",
    "**/__pycache__",
    "**/build",
    "**/.git"
  ],
  "include": [
    "src",
    "tests"
  ],
  "typeCheckingMode": "strict",
  "pythonVersion": "3.13",
  "diagnosticMode": "openFilesOnly",
  "stubPath": "./typings",
  "autoImportCompletions": true,
  "extraPaths": [
    "/Users/admin/.pyenv/versions/3.13.2/envs/neovim-env/lib/python3.13/site-packages"
  ]
}
